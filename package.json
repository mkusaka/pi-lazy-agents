{
  "name": "pi-lazy-agents",
  "version": "0.0.1",
  "description": "Load descendant AGENTS.md files and .agents/skills into ephemeral pi model context on file access.",
  "type": "module",
  "license": "MIT",
  "author": "mkusaka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkusaka/pi-lazy-agents.git"
  },
  "files": [
    "config.ts",
    "discovery.ts",
    "index.ts",
    "injection.ts",
    "path.ts",
    "registry.ts",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "agents-md",
    "lazy-loading"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "bun check",
    "fmt": "bun fmt --no-script",
    "lint": "oxlint",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "24.19.2",
    "oxlint": "1.89.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
